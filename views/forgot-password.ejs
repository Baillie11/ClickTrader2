<%- include("partials/header") %>

<section class="auth-shell">
  <form class="auth-panel" method="post" action="/forgot-password">
    <h1>Reset Password</h1>
    <p>Enter your account email to generate a temporary reset link.</p>
    <label>
      Email
      <input type="email" name="email" required autocomplete="email">
    </label>
    <button class="primary-button" type="submit">Create Reset Link</button>
    <% if (resetLink) { %>
      <div class="reset-link-box">
        <span>Temporary reset link</span>
        <a href="<%= resetLink %>"><%= resetLink %></a>
      </div>
    <% } %>
    <p><a href="/login">Back to login</a></p>
  </form>
</section>

<%- include("partials/footer") %>
