NODE_ENV=production
PORT=3000
SESSION_SECRET=replace-with-a-long-random-string
COOKIE_SECURE=false

# Alpaca paper trading. Leave blank to use the local simulated paper ledger.
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Alpaca live trading. Only fill these when you are ready for live orders.
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# Default trading posture.
DEFAULT_TRADE_MODE=paper
DEFAULT_MARKET=nasdaq
SIMULATED_STARTING_CASH=10000
